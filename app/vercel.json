{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/integrations/v1/:path*", "destination": "/api/integrations?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/google-calendar-sync", "schedule": "0 8 * * *" }
  ]
}
